# ==============================================================================
# Food Ordering Application (3-Tier) Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Or for production:
#   cp .env.example /opt/food-order-3tier-aws/shared/.env
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=food_db

# Backend Security Configuration
# In production, generate a secure 64-char key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
