# ==============================================================================
# Food Ordering Application (3-Tier) Environment Configuration Template
# ==============================================================================
# Copy this file to shared/.env on the production server:
#   /opt/food-order-3tier-aws/shared/.env
#
# Ensure all placeholders are filled with secure production credentials.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=food_db

# Backend JWT & Security Configuration
# SECRET_KEY: Generate with `openssl rand -hex 32`
SECRET_KEY=your_64_character_hex_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
